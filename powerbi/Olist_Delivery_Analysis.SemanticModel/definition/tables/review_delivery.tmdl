table 'Review Delivery'
	lineageTag: 3e4a1f04-7a01-4f21-a005-000000000001

	measure 'Review Count' =
			SUM('Review Delivery'[review_count])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a005-000000000006

	column delivery_class
		dataType: string
		lineageTag: 3e4a1f04-7a01-4f21-a005-000000000002
		summarizeBy: none
		sourceColumn: delivery_class

	column review_score
		dataType: int64
		formatString: 0
		lineageTag: 3e4a1f04-7a01-4f21-a005-000000000003
		sourceColumn: review_score

	column review_count
		dataType: int64
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a005-000000000004
		sourceColumn: review_count

	column orders_without_usable_review
		dataType: int64
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a005-000000000005
		sourceColumn: orders_without_usable_review

	partition review_delivery = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("F:\olist-delivery-performance-analysis\reports\exports\olist_snapshot_1\review_delivery.csv"),[Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"delivery_class", type text}, {"review_score", Int64.Type}, {"review_count", Int64.Type}, {"orders_without_usable_review", Int64.Type}})
				in
					#"Changed Type"

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
