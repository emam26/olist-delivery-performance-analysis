table 'Source Provenance'
	lineageTag: 3e4a1f04-7a01-4f21-a007-000000000001

	measure 'Loaded Source Rows' =
			SUM('Source Provenance'[inserted_row_count])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000011

	measure 'Active Snapshot ID' =
			SELECTEDVALUE('Source Provenance'[dataset_snapshot_id])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000012

	measure 'Source Manifest Hash' =
			SELECTEDVALUE('Source Provenance'[source_manifest_sha256], "Not available")
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000013

	column dataset_snapshot_id
		dataType: int64
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000002
		sourceColumn: dataset_snapshot_id

	column source_manifest_sha256
		dataType: string
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000003
		summarizeBy: none
		sourceColumn: source_manifest_sha256

	column dataset_name
		dataType: string
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000004
