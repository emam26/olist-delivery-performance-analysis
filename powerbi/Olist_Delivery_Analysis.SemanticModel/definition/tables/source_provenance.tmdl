	column expected_row_count
		dataType: int64
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000008
		sourceColumn: expected_row_count

	column inserted_row_count
		dataType: int64
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000009
		sourceColumn: inserted_row_count

	column completed_at_utc
		dataType: dateTime
		formatString: General Date
		lineageTag: 3e4a1f04-7a01-4f21-a007-000000000010
		summarizeBy: none
		sourceColumn: completed_at_utc

	partition source_provenance = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("F:\olist-delivery-performance-analysis\reports\exports\olist_snapshot_1\source_provenance.csv"),[Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"dataset_snapshot_id", Int64.Type}, {"source_manifest_sha256", type text}, {"dataset_name", type text}, {"load_batch_id", Int64.Type}, {"source_filename", type text}, {"source_sha256", type text}, {"expected_row_count", Int64.Type}, {"inserted_row_count", Int64.Type}, {"completed_at_utc", type datetime}})
				in
					#"Changed Type"

	annotation PBI_NavigationStepName = Navigation
	annotation PBI_ResultType = Table
