table order_delivery
	lineageTag: 5c90162c-8fb9-4e61-beb9-3fae0c69fc6c

	measure 'Total Orders' =

			COUNTROWS('order_delivery')
		formatString: #,0
		lineageTag: f4d5e0b1-b684-4e59-a9aa-e2185191267f

	measure 'Delivered Orders' = CALCULATE([Total Orders], 'order_delivery'[is_delivered] = TRUE())
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000001

	measure 'Delivery Eligible Orders' = CALCULATE([Total Orders], 'order_delivery'[is_delivery_eligible] = TRUE())
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000002

	measure 'On-Time Orders' =
			CALCULATE(
				[Total Orders],
				'order_delivery'[is_delivery_eligible] = TRUE(),
				'order_delivery'[is_late] = FALSE()
			)
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000003

	measure 'Late Orders' =
			CALCULATE(
				[Total Orders],
				'order_delivery'[is_delivery_eligible] = TRUE(),
				'order_delivery'[is_late] = TRUE()
			)
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000004

	measure 'On-Time Rate' = DIVIDE([On-Time Orders], [Delivery Eligible Orders])
		formatString: 0.00%
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000005

	measure 'Late Rate' = DIVIDE([Late Orders], [Delivery Eligible Orders])
		formatString: 0.00%
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000006

	measure 'Delivery Status Excluded Orders' = [Total Orders] - [Delivery Eligible Orders]
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000007

	measure 'Duration Eligible Orders' = CALCULATE([Total Orders], 'order_delivery'[is_duration_eligible] = TRUE())
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000008

	measure 'Duration Excluded Orders' = [Total Orders] - [Duration Eligible Orders]
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000009

	measure 'Delivery Exclusion Reason Orders' =
			IF(
				ISINSCOPE('order_delivery'[delivery_exclusion_reason])
					&& NOT ISBLANK(SELECTEDVALUE('order_delivery'[delivery_exclusion_reason])),
				CALCULATE([Total Orders], 'order_delivery'[is_delivery_eligible] = FALSE())
			)
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000020

	measure 'Duration Exclusion Reason Orders' =
			IF(
				ISINSCOPE('order_delivery'[duration_exclusion_reason])
					&& NOT ISBLANK(SELECTEDVALUE('order_delivery'[duration_exclusion_reason])),
				CALCULATE([Total Orders], 'order_delivery'[is_duration_eligible] = FALSE())
			)
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000021

	measure 'Average Delivery Days' =
			CALCULATE(
				DIVIDE(AVERAGE('order_delivery'[delivery_duration_hours]), 24),
				'order_delivery'[is_duration_eligible] = TRUE()
			)
		formatString: 0.00
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000010

	measure 'Median Delivery Days' =
			CALCULATE(
				PERCENTILEX.INC(
					'order_delivery',
					DIVIDE('order_delivery'[delivery_duration_hours], 24),
					0.5
				),
				'order_delivery'[is_duration_eligible] = TRUE()
			)
		formatString: 0.00
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000011

	measure 'P90 Delivery Days' =
			CALCULATE(
				PERCENTILEX.INC(
					'order_delivery',
					DIVIDE('order_delivery'[delivery_duration_hours], 24),
					0.9
				),
				'order_delivery'[is_duration_eligible] = TRUE()
			)
		formatString: 0.00
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000012

	measure 'P95 Delivery Days' =
			CALCULATE(
				PERCENTILEX.INC(
					'order_delivery',
					DIVIDE('order_delivery'[delivery_duration_hours], 24),
					0.95
				),
				'order_delivery'[is_duration_eligible] = TRUE()
			)
		formatString: 0.00
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000013

	measure 'Average Days Late' =
			CALCULATE(
				AVERAGE('order_delivery'[days_late]),
				'order_delivery'[is_delivery_eligible] = TRUE(),
				'order_delivery'[is_late] = TRUE()
			)
		formatString: 0.0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000014

	measure 'Reviewed Orders' =
			CALCULATE(
				[Total Orders],
				NOT ISBLANK('order_delivery'[selected_review_score])
			)
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000015

	measure 'Orders Without Usable Review' = [Total Orders] - [Reviewed Orders]
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000016

	measure 'Average Review Score' =
			CALCULATE(
				AVERAGE('order_delivery'[selected_review_score]),
				NOT ISBLANK('order_delivery'[selected_review_score])
			)
		formatString: 0.0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000017

	measure 'Minimum Group Size' = 30
		formatString: #,0
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000018

	measure 'Review Page Title' = "Delivery timing and review score - descriptive association"
		lineageTag: 2d3b7e2f-7f7a-4b2f-9aa5-000000000019

