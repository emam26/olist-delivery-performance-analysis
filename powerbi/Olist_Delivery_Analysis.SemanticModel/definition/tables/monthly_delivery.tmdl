table 'Monthly Delivery'
	lineageTag: 3e4a1f04-7a01-4f21-a001-000000000001

	measure 'Eligible Orders' =
			SUM('Monthly Delivery'[eligible_order_count])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a001-000000000017

	measure 'On-Time Rate' =
			DIVIDE(
				SUM('Monthly Delivery'[on_time_order_count]),
				SUM('Monthly Delivery'[eligible_order_count])
			)
		formatString: 0.00%
		lineageTag: 3e4a1f04-7a01-4f21-a001-000000000018

	measure 'Late Rate' =
			DIVIDE(
				SUM('Monthly Delivery'[late_order_count]),
				SUM('Monthly Delivery'[eligible_order_count])
			)
		formatString: 0.00%
		lineageTag: 3e4a1f04-7a01-4f21-a001-000000000019

	measure 'Delivery Status Excluded Orders' =
			SUM('Monthly Delivery'[delivery_status_excluded_order_count])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a001-000000000020

	measure 'Duration Eligible Orders' =
			SUM('Monthly Delivery'[duration_eligible_order_count])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a001-000000000021

	column purchase_month
		dataType: dateTime
		formatString: MMM yyyy
		lineageTag: 3e4a1f04-7a01-4f21-a001-000000000002
