table 'Data Quality'
	lineageTag: 3e4a1f04-7a01-4f21-a006-000000000001

	measure 'Failed Quality Checks' =
			COALESCE(
				CALCULATE(COUNTROWS('Data Quality'), 'Data Quality'[check_status] = "Failed"),
				0
			)
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a006-000000000013

	measure 'Warning Quality Checks' = CALCULATE(COUNTROWS('Data Quality'), 'Data Quality'[check_status] = "Warning")
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a006-000000000014

	measure 'Validation Status' = SELECTEDVALUE('Data Quality'[run_status], "Not available")
		lineageTag: 3e4a1f04-7a01-4f21-a006-000000000015

	measure 'Validation Run ID' = SELECTEDVALUE('Data Quality'[validation_run_id])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a006-000000000016

	column validation_run_id
		dataType: int64
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a006-000000000002
		sourceColumn: validation_run_id

	column dataset_snapshot_id
