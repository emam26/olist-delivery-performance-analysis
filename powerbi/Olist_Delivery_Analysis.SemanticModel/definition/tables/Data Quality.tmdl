	partition data_quality = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents("F:\olist-delivery-performance-analysis\reports\exports\olist_snapshot_1\validation_results.csv"),[Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
