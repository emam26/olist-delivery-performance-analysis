table 'Seller Delivery'
	lineageTag: 3e4a1f04-7a01-4f21-a003-000000000001

	measure 'Eligible Orders' =
			SUM('Seller Delivery'[eligible_order_count])
		formatString: #,0
		lineageTag: 3e4a1f04-7a01-4f21-a003-000000000017

	measure 'On-Time Rate (Min Eligible 30)' =
			VAR Eligible = SUM('Seller Delivery'[eligible_order_count])
			RETURN
				IF(
					Eligible >= [Minimum Group Size],
					DIVIDE(SUM('Seller Delivery'[on_time_order_count]), Eligible)
				)
		formatString: 0.00%
		lineageTag: 3e4a1f04-7a01-4f21-a003-000000000018

	measure 'Late Rate (Min Eligible 30)' =
			VAR Eligible = SUM('Seller Delivery'[eligible_order_count])
			RETURN
				IF(
					Eligible >= [Minimum Group Size],
					DIVIDE(SUM('Seller Delivery'[late_order_count]), Eligible)
				)
		formatString: 0.00%
		lineageTag: 3e4a1f04-7a01-4f21-a003-000000000019

