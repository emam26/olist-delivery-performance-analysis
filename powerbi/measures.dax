// Create these measures in the Order Delivery table unless noted otherwise.
// Column names follow reporting.vw_order_delivery_detail.

Orders =
COUNTROWS('Order Delivery')

Delivery Eligible Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[delivery_classification] IN { "On Time", "Late" }
)

On-Time Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[delivery_classification] = "On Time"
)

Late Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[delivery_classification] = "Late"
)

On-Time Rate =
DIVIDE([On-Time Orders], [Delivery Eligible Orders])

Late Rate =
DIVIDE([Late Orders], [Delivery Eligible Orders])

Delivery Status Excluded Orders =
[Orders] - [Delivery Eligible Orders]

Duration Eligible Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[duration_eligible] = 1
)

Average Delivery Days =
CALCULATE(
    AVERAGE('Order Delivery'[delivery_duration_days]),
    'Order Delivery'[duration_eligible] = 1
)

Median Delivery Days =
CALCULATE(
    PERCENTILEX.INC(
        'Order Delivery',
        'Order Delivery'[delivery_duration_days],
        0.5
    ),
    'Order Delivery'[duration_eligible] = 1
)

P90 Delivery Days =
CALCULATE(
    PERCENTILEX.INC(
        'Order Delivery',
        'Order Delivery'[delivery_duration_days],
        0.9
    ),
    'Order Delivery'[duration_eligible] = 1
)

P95 Delivery Days =
CALCULATE(
    PERCENTILEX.INC(
        'Order Delivery',
        'Order Delivery'[delivery_duration_days],
        0.95
    ),
    'Order Delivery'[duration_eligible] = 1
)

Average Days Early or Late =
CALCULATE(
    AVERAGE('Order Delivery'[days_early_or_late]),
    'Order Delivery'[delivery_classification] IN { "On Time", "Late" }
)

Reviewed Orders =
CALCULATE(
    [Orders],
    NOT ISBLANK('Order Delivery'[selected_review_score])
)

Average Review Score =
CALCULATE(
    AVERAGE('Order Delivery'[selected_review_score]),
    NOT ISBLANK('Order Delivery'[selected_review_score])
)

Minimum Group Size = 30

Eligible Group =
IF([Delivery Eligible Orders] >= [Minimum Group Size], 1, 0)

// Optional title makes the observational scope explicit.
Review Page Title =
"Delivery timing and review score — descriptive association"

// Create this measure in Data Quality.
Failed Quality Checks =
CALCULATE(
    COUNTROWS('Data Quality'),
    'Data Quality'[status] = "Failed"
)
