// Create these measures in the Order Delivery table unless noted otherwise.
// Column names follow reporting.vw_order_delivery_detail.

Orders =
DISTINCTCOUNT('Order Delivery'[order_id])

Delivered Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[is_delivered] = 1
)

Delivery Eligible Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[is_delivery_eligible] = 1
)

On-Time Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[is_delivery_eligible] = 1,
    'Order Delivery'[is_late] = 0
)

Late Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[is_delivery_eligible] = 1,
    'Order Delivery'[is_late] = 1
)

On-Time Rate =
DIVIDE([On-Time Orders], [Delivery Eligible Orders])

Late Rate =
DIVIDE([Late Orders], [Delivery Eligible Orders])

Delivery Status Excluded Orders =
[Orders] - [Delivery Eligible Orders]

Duration Eligible Orders =
CALCULATE(
    [Orders],
    'Order Delivery'[is_duration_eligible] = 1
)

Duration Excluded Orders =
[Orders] - [Duration Eligible Orders]

Average Delivery Days =
CALCULATE(
    DIVIDE(AVERAGE('Order Delivery'[delivery_duration_hours]), 24),
    'Order Delivery'[is_duration_eligible] = 1
)

Median Delivery Days =
CALCULATE(
    PERCENTILEX.INC(
        'Order Delivery',
        DIVIDE('Order Delivery'[delivery_duration_hours], 24),
        0.5
    ),
    'Order Delivery'[is_duration_eligible] = 1
)

P90 Delivery Days =
CALCULATE(
    PERCENTILEX.INC(
        'Order Delivery',
        DIVIDE('Order Delivery'[delivery_duration_hours], 24),
        0.9
    ),
    'Order Delivery'[is_duration_eligible] = 1
)

P95 Delivery Days =
CALCULATE(
    PERCENTILEX.INC(
        'Order Delivery',
        DIVIDE('Order Delivery'[delivery_duration_hours], 24),
        0.95
    ),
    'Order Delivery'[is_duration_eligible] = 1
)

Average Days Late =
CALCULATE(
    AVERAGE('Order Delivery'[days_late]),
    'Order Delivery'[is_delivery_eligible] = 1,
    'Order Delivery'[is_late] = 1
)

Reviewed Orders =
CALCULATE(
    [Orders],
    NOT ISBLANK('Order Delivery'[selected_review_score])
)

Average Review Score =
CALCULATE(
    AVERAGE('Order Delivery'[selected_review_score]),
    NOT ISBLANK('Order Delivery'[selected_review_score])
)

Orders Without Usable Review =
[Orders] - [Reviewed Orders]

Minimum Group Size = 30

// Optional title makes the observational scope explicit.
Review Page Title =
"Delivery timing and review score - descriptive association"

// Create this measure in Data Quality.
Failed Quality Checks =
CALCULATE(
    COUNTROWS('Data Quality'),
    'Data Quality'[check_status] = "Failed"
)

Warning Quality Checks =
CALCULATE(
    COUNTROWS('Data Quality'),
    'Data Quality'[check_status] = "Warning"
)

Validation Status =
SELECTEDVALUE('Data Quality'[run_status], "Not available")

Validation Run ID =
SELECTEDVALUE('Data Quality'[validation_run_id])

// Create this measure in Source Provenance.
Loaded Source Rows =
SUM('Source Provenance'[inserted_row_count])

Active Snapshot ID =
SELECTEDVALUE('Source Provenance'[dataset_snapshot_id])

Source Manifest Hash =
SELECTEDVALUE('Source Provenance'[source_manifest_sha256], "Not available")
