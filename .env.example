# Copy to .env and enter local values. Never commit .env or real credentials.
SQL_SERVER_DRIVER=ODBC Driver 18 for SQL Server
SQL_SERVER_HOST=your-windows-host-or-server
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=your_database_name
SQL_SERVER_USER=your_application_login
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=yes
SQL_SERVER_TRUST_CERTIFICATE=no

OLIST_DATA_DIRECTORY=data/raw
OLIST_REPORT_DIRECTORY=reports
OLIST_EXPORT_DIRECTORY=reports/exports
OLIST_LOAD_BATCH_SIZE=1000
OLIST_MIN_GROUP_SIZE=30
